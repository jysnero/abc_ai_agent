{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Contract Schema v1.0",
  "description": "AI Agent 계약서 패턴 (minigame shell)",
  "type": "object",
  "required": ["agent_metadata", "capabilities", "bridge_api_contract"],
  "properties": {
    "agent_metadata": {
      "type": "object",
      "required": ["name", "version", "role"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Agent 이름"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic versioning"
        },
        "role": {
          "type": "string",
          "enum": ["developer", "validator", "optimizer", "executor", "monitor", "feedback", "config"],
          "description": "Agent의 역할"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["core_functions"],
      "properties": {
        "core_functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "input_schema": {
                "type": "object"
              },
              "output_schema": {
                "type": "object"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "다른 Agent와의 의존성"
        }
      }
    },
    "bridge_api_contract": {
      "type": "object",
      "description": "⚠️ 이것은 EXAMPLE입니다 - 네이티브 앱팀에서 실제 스펙을 받아서 교체하세요",
      "properties": {
        "api_base_url": {
          "type": "string",
          "example": "https://api.example.com",
          "description": "EXAMPLE: 실제 URL로 교체 필수"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "method": {
                "type": "string",
                "enum": ["GET", "POST", "PUT", "DELETE"]
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "authentication": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["bearer", "api_key", "oauth2"]
            }
          }
        }
      }
    },
    "validation_rules": {
      "type": "object",
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
