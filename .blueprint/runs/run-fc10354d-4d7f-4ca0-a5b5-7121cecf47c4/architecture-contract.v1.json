{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Checkbox Component Architecture Contract",
  "description": "Architecture constraints for React Checkbox component generation",
  "required": ["name", "required_files", "allowed_globs", "validation"],
  "properties": {
    "name": {
      "type": "string",
      "const": "react-checkbox-component"
    },
    "required_files": {
      "type": "array",
      "description": "Files that MUST be generated",
      "items": { "type": "string" },
      "examples": [
        ["src/Checkbox.tsx", "src/Checkbox.test.tsx", "README.md"]
      ]
    },
    "allowed_globs": {
      "type": "array",
      "description": "File patterns that are allowed to be modified/created",
      "items": { "type": "string" },
      "examples": [
        ["src/**/*.tsx", "src/**/*.ts", "**/*.md"]
      ]
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "npm_packages": {
          "type": "array",
          "items": { "type": "string" },
          "examples": [["react@^18.0.0", "typescript@^5.0.0"]]
        },
        "dev_packages": {
          "type": "array",
          "items": { "type": "string" },
          "examples": [["vitest@^1.0.0", "react-testing-library@^14.0.0"]]
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "build_cmd": {
          "type": "string",
          "description": "Command to verify build succeeds",
          "examples": ["tsc --noEmit"]
        },
        "test_cmd": {
          "type": "string",
          "description": "Command to run tests",
          "examples": ["vitest run"]
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "language": { "type": "string", "const": "TypeScript" },
        "framework": { "type": "string", "const": "React 18+" },
        "styling": { "type": "string", "const": "Tailwind CSS" },
        "accessibility": { "type": "string", "const": "WCAG 2.1 AA (keyboard + ARIA)" }
      }
    }
  }
}
