{
  "name": "ai-agent-platform",
  "version": "0.1.0",
  "description": "AI Agent Platform - Multi-Agent Orchestration Framework",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "check:arch": "tsx scripts/check-arch.ts",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:workflow && npm run test:validation",
    "test:unit": "npm run test:unit:orchestrator && npm run test:unit:plan-builder && npm run test:unit:storage",
    "test:unit:orchestrator": "node --test --test-reporter=spec dist/tests/unit/orchestrator.test.js",
    "test:unit:plan-builder": "node --test --test-reporter=spec dist/tests/unit/plan-builder.test.js",
    "test:unit:storage": "node --test --test-reporter=spec dist/tests/unit/run-storage.test.js",
    "test:workflow": "node --test --test-reporter=spec dist/tests/workflow-runner.integration.test.js",
    "test:validation": "node --test --test-reporter=spec dist/tests/integration/validation-runner.integration.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@types/node": "^20.10.0",
    "minimatch": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
